{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd web && npm ci",
  "buildCommand": "cd web && VITE_SAME_ORIGIN=1 npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{sanket/**,artifacts/registry.json,artifacts/models/v1/**,artifacts/nn/card.json,data/splits/stream.csv,scripts/seed.py}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!replay.json|assets/).*)", "destination": "/index.html" }
  ]
}
